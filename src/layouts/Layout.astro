---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/studio.css";
interface Props {
  title?: string; description?: string; image?: string; type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]; noindex?: boolean;
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = "/og-default.png", type = "website", jsonLd, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImage = new URL(image, Astro.site);
const navigation = [
  { href: "/", label: "Journal", active: currentPath === "/" || currentPath.startsWith("/page/") },
  { href: "/recordings", label: "Recordings", active: currentPath.startsWith("/recordings") },
  { href: "/experiments", label: "Experiments", active: currentPath.startsWith("/experiments") },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="studio">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-identity">
        <a href="/" class="wordmark" aria-label="Viktor’s Patchlog home">Viktor’s<br /> patchlog<span>.</span></a>
        <p class="site-bio">A working diary of modular synths, recordings, and experiments.</p>
        <nav class="site-nav" aria-label="Main navigation">
          {navigation.map((item, i) => <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}<span aria-hidden="true">0{i + 1}</span></a>)}
        </nav>
        <nav class="side-links" aria-label="Archive and links">
          <a href="/calendar" aria-current={currentPath.startsWith("/calendar") ? "page" : undefined}>Calendar</a>
          <a href="/rss.xml">RSS ↗</a>
          <a href="https://www.instagram.com/viktor.patchlog" target="_blank" rel="me noopener noreferrer">Instagram ↗</a>
        </nav>
        <p class="site-byline">By Viktor Kelemen<br />Patch / listen / repeat</p>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer"><span>Practice makes progress.</span><a href="/rss.xml">Follow via RSS ↗</a></footer>
    </div>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"519d337fe766426ebebd776aabcb9eb6"}'></script>
  </body>
</html>
