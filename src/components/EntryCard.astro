---
import VideoEmbed from "./VideoEmbed.astro";
import AudioPlayer from "./AudioPlayer.astro";
import SoundCloudEmbed from "./SoundCloudEmbed.astro";
import type { CollectionEntry } from "astro:content";
import { toExcerpt } from "../lib/excerpt";
import { entryKind } from "../lib/entry-kind";
interface Props { entry: CollectionEntry<"entries">; lead?: boolean; compact?: boolean; }
const { entry, lead = false, compact = false } = Astro.props;
const { data } = entry;
const videos = data.videoUrl ? (Array.isArray(data.videoUrl) ? data.videoUrl : [data.videoUrl]) : [];
const rawAudio = data.audioUrl ? (Array.isArray(data.audioUrl) ? data.audioUrl : [data.audioUrl]) : [];
const audio = rawAudio.map((a) => typeof a === "string" ? { url: a } : a);
const formattedDate = data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const excerpt = toExcerpt(entry.body ?? "", lead ? 230 : 175);
const showMedia = !compact;
const shortVideo = videos.length === 1 && videos[0].includes("/shorts/") && showMedia;
---
<article class:list={["entry-card", { lead, compact, "has-short": shortVideo }]} id={`entry-${entry.id}`}>
  <div class="entry-meta"><time datetime={data.date.toISOString()}>{formattedDate}</time><span>{entryKind(entry)}</span></div>
  <div class="entry-summary">
    <h2><a href={`/entry/${entry.id}`}>{data.title}</a></h2>
    {!compact && excerpt && <p class="entry-excerpt">{excerpt}</p>}
    {!compact && <a class="entry-read" href={`/entry/${entry.id}`}>Read the entry ↗</a>}
  </div>
  {showMedia && videos.length > 0 && <div class:list={["card-videos", { "single": videos.length === 1 }]}>{videos.slice(0, 2).map(url => <VideoEmbed url={url} />)}</div>}
  {showMedia && audio.length > 0 && (audio.length > 4 ? <a class="audio-teaser" href={`/entry/${entry.id}`}>{audio.length} audio samples — listen ↗</a> : <div class="audio-list">{audio.map(item => item.url.includes("soundcloud.com") ? <SoundCloudEmbed url={item.url} /> : <AudioPlayer url={item.url} />)}</div>)}
</article>
