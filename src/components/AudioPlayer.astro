---
interface Props { url: string; }
const { url } = Astro.props;
const filename = decodeURIComponent(url.split("/").pop()?.split("?")[0] || "Recording");
const label = filename.replace(/\.[^.]+$/, "").replace(/[-_]/g, " ");
---
<div class="waveform-player">
  <audio src={url} preload="metadata" controls aria-label={label}></audio>
  <div class="audio-custom" hidden>
    <div class="audio-top"><button class="play-btn" type="button" aria-label={`Play ${label}`}>Play</button><p class="audio-title">{label}</p></div>
    <label class="audio-seek-label">Playback position<input class="audio-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label={`Playback position: ${label}`} disabled /></label>
    <div class="audio-times"><span class="elapsed">0:00</span><span class="duration">0:00</span></div>
    <p class="audio-status" aria-live="polite">Ready to listen.</p>
  </div>
  <a class="audio-file-link" href={url} target="_blank" rel="noopener">Open audio file ↗</a>
</div>
<style>
  .waveform-player{margin:16px 0}audio{width:100%}.audio-top{display:flex;gap:18px;align-items:center}.play-btn{width:55px;height:55px;flex-shrink:0;border:0;border-radius:50%;background:var(--fg);color:var(--inverse);font:12px var(--mono)}.audio-title{font:500 19px/1.35 var(--display);margin:0;overflow-wrap:anywhere}.audio-seek-label{display:block;font:11px/1.5 var(--mono);margin-top:22px}.audio-seek{display:block;width:100%;min-height:30px;margin:0;accent-color:var(--fg)}.audio-times{display:flex;justify-content:space-between;font:11px var(--mono)}.audio-status{font:11px/1.6 var(--mono);min-height:18px;margin:15px 0 8px}.audio-file-link{font:11px/1.5 var(--mono)}
</style>
<script>
  const fmt = (seconds: number) => Number.isFinite(seconds) ? `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2,"0")}` : "0:00";
  document.querySelectorAll<HTMLElement>(".waveform-player").forEach(container => {
    const audio = container.querySelector("audio")!;
    const custom = container.querySelector<HTMLElement>(".audio-custom")!;
    const button = container.querySelector<HTMLButtonElement>(".play-btn")!;
    const seek = container.querySelector<HTMLInputElement>(".audio-seek")!;
    const status = container.querySelector<HTMLElement>(".audio-status")!;
    audio.controls = false; audio.hidden = true; custom.hidden = false;
    const sync = () => {
      const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
      seek.disabled = duration <= 0;
      seek.max = String(duration || 100); seek.value = String(audio.currentTime);
      seek.setAttribute("aria-valuetext", `${fmt(audio.currentTime)} of ${fmt(duration)}`);
      container.querySelector(".elapsed")!.textContent = fmt(audio.currentTime);
      container.querySelector(".duration")!.textContent = fmt(duration);
      button.textContent = audio.paused ? "Play" : "Pause";
      button.setAttribute("aria-label", `${audio.paused ? "Play" : "Pause"} ${audio.getAttribute("aria-label")}`);
    };
    button.addEventListener("click", async () => {
      if (!audio.paused) { audio.pause(); return; }
      if (audio.error) audio.load();
      status.textContent = "Loading…";
      try { await audio.play(); } catch { status.textContent = "Could not play. Try again or open the audio file."; }
    });
    audio.addEventListener("play", () => { window.dispatchEvent(new CustomEvent("patchlog:play", { detail: audio })); sync(); });
    audio.addEventListener("playing", () => status.textContent = "Playing.");
    audio.addEventListener("pause", () => { status.textContent = "Paused."; sync(); });
    audio.addEventListener("ended", () => { status.textContent = "Finished."; sync(); });
    audio.addEventListener("error", () => status.textContent = "Audio unavailable. Try again or open the audio file.");
    ["timeupdate","loadedmetadata","durationchange"].forEach(event => audio.addEventListener(event, sync));
    seek.addEventListener("input", () => { if (Number.isFinite(audio.duration)) audio.currentTime = Number(seek.value); sync(); });
    window.addEventListener("patchlog:play", event => { if ((event as CustomEvent).detail !== audio) audio.pause(); });
    window.addEventListener("pagehide", () => audio.pause());
    sync();
  });
</script>
